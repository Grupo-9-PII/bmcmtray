4. Aplicação Flask (app.py)
Neste arquivo, criaremos as rotas para ler e atualizar as configurações.


from flask import Flask, render_template, request, redirect, url_for, flash
from flask_mysqldb import MySQL
from config import Config
import os

app = Flask(__name__)
app.config.from_object(Config)
app.secret_key = 'supersecretkey' # Necessário para flash messages

mysql = MySQL(app)

@app.route('/settings', methods=['GET', 'POST'])
def settings():
    if request.method == 'POST':
        # Receber dados do formulário
        host = request.form['host']
        user = request.form['user']
        password = request.form['password']
        db = request.form['db']
        
        # Atualizar arquivo .env (forma simples)
        with open('.env', 'w') as f:
            f.write(f"MYSQL_HOST={host}\n")
            f.write(f"MYSQL_USER={user}\n")
            f.write(f"MYSQL_PASSWORD={password}\n")
            f.write(f"MYSQL_DB={db}\n")
            
        flash('Configurações atualizadas! Reinicie a aplicação.', 'success')
        return redirect(url_for('settings'))
    
    # GET: Exibir configurações atuais
    return render_template('settings.html', config=app.config)

if __name__ == '__main__':
    app.run(debug=True)